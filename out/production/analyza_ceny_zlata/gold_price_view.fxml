<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.CategoryAxis?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="GoldPriceController"
           prefWidth="980.0"
           prefHeight="900.0">

    <ImageView fitWidth="980"
               fitHeight="900"
               preserveRatio="false"
               opacity="0.85">
        <image>
            <Image url="@images/gold.jpg"/>
        </image>
    </ImageView>

    <BorderPane styleClass="main-overlay">

        <top>
            <VBox alignment="CENTER" spacing="8">
                <padding>
                    <Insets top="28" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="ANALÝZA CENY ZLATA"
                       styleClass="title-label">
                    <font>
                        <Font name="Serif Bold" size="38"/>
                    </font>
                </Label>

                <Label text="Program na analýzu cien zlata z CSV datasetu"
                       styleClass="subtitle-label">
                    <font>
                        <Font name="System" size="15"/>
                    </font>
                </Label>
            </VBox>
        </top>

        <center>
            <VBox spacing="16">
                <padding>
                    <Insets top="12" right="35" bottom="30" left="35"/>
                </padding>

                <GridPane hgap="12" vgap="12" styleClass="card-panel">
                    <padding>
                        <Insets top="22" right="24" bottom="22" left="24"/>
                    </padding>

                    <Label text="Rok:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>

                    <TextField fx:id="yearField"
                               text="2024"
                               promptText="Zadaj rok"
                               prefWidth="150"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <Label text="Mena:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                    <ComboBox fx:id="currencyComboBox"
                              prefWidth="150"
                              GridPane.rowIndex="0"
                              GridPane.columnIndex="3"/>

                    <Label text="Jednotka výpisu:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                    <ComboBox fx:id="unitComboBox"
                              prefWidth="150"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"/>

                    <Label text="Kurz USD → EUR:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

                    <TextField fx:id="exchangeRateField"
                               text="0.92"
                               promptText="napr. 0.92"
                               prefWidth="150"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="3"/>

                    <Label text="Dátum nákupu:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>

                    <TextField fx:id="purchaseDateField"
                               text="2010-10"
                               promptText="yyyy-MM"
                               prefWidth="150"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                    <Label text="Množstvo zlata:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

                    <TextField fx:id="ouncesField"
                               text="10"
                               promptText="v oz"
                               prefWidth="150"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="3"/>

                </GridPane>

                <VBox spacing="12" styleClass="button-panel">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>

                    <HBox spacing="12" alignment="CENTER">
                        <Button text="Reset formulára"
                                onAction="#handleResetForm"
                                prefWidth="160"
                                prefHeight="35"
                                styleClass="gold-button"/>

                        <Button text="Mesačné ceny"
                                onAction="#handleShowYearPrices"
                                prefWidth="145"
                                prefHeight="35"
                                styleClass="gold-button"/>

                        <Button text="Priemer v roku"
                                onAction="#handleShowAverageForYear"
                                prefWidth="145"
                                prefHeight="35"
                                styleClass="gold-button"/>

                        <Button text="Medián v roku"
                                onAction="#handleShowMedian"
                                prefWidth="145"
                                prefHeight="35"
                                styleClass="gold-button"/>
                    </HBox>

                    <HBox spacing="12" alignment="CENTER">
                        <Button text="Vymazať výstup"
                                onAction="#handleClearOutput"
                                prefWidth="160"
                                prefHeight="35"
                                styleClass="gold-button"/>

                        <Button text="Maximum datasetu"
                                onAction="#handleShowMaximumAll"
                                prefWidth="160"
                                prefHeight="35"
                                styleClass="gold-button-strong"/>

                        <Button text="Maximum v roku"
                                onAction="#handleShowMaximumForYear"
                                prefWidth="160"
                                prefHeight="35"
                                styleClass="gold-button-strong"/>

                        <Button text="Hodnota majetku"
                                onAction="#handleCalculateAssetValue"
                                prefWidth="160"
                                prefHeight="35"
                                styleClass="gold-button-strong"/>
                    </HBox>

                    <HBox spacing="18" alignment="CENTER">
                        <CheckBox fx:id="showChartCheckBox"
                                  text="Zobraziť graf"
                                  onAction="#handleToggleChart"/>

                        <CheckBox fx:id="themeCheckBox"
                                  text="Svetlý režim"
                                  onAction="#handleToggleTheme"/>

                    </HBox>
                </VBox>

                <LineChart fx:id="lineChart"
                           prefHeight="300"
                           title="Vývoj ceny zlata"
                           visible="false"
                           managed="false"
                           createSymbols="true"
                           animated="false"
                           styleClass="gold-chart">

                    <xAxis>
                        <CategoryAxis label="Dátum"/>
                    </xAxis>

                    <yAxis>
                        <NumberAxis label="Cena"/>
                    </yAxis>
                </LineChart>

                <TextArea fx:id="outputArea"
                          editable="false"
                          wrapText="false"
                          prefHeight="330"
                          styleClass="output-area"/>
            </VBox>
        </center>
    </BorderPane>
</StackPane>